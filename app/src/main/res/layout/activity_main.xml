<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_main"
        android:padding="16dp">

        <TextView
            android:text="HEADLOCK PLUS"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingTop="8dp"
            android:paddingBottom="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:background="@drawable/card_top"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvCpu"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/ring_purple"
                    android:layout_width="78dp"
                    android:layout_height="78dp"/>
                <TextView
                    android:text="CPU"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:paddingTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvRam"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/ring_green"
                    android:layout_width="78dp"android:layout_height="78dp"/>
                <TextView
                    android:text="RAM"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:paddingTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvNet"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/ring_blue"
                    android:layout_width="78dp"
                    android:layout_height="78dp"/>
                <TextView
                    android:text="NETWORK"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:paddingTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/row_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:text="🎯"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="AIMLOCK PLUS"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Switch
                    android:id="@+id/swAimlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/></LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:text="🚀"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="BOOST RAM"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Switch
                    android:id="@+id/swBoost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:text="💀"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="SENSITIVITY"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Switch
                    android:id="@+id/swAntiShake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:text="⚙️"
                    android:textSize="20sp"android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="FIX RUNG"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Switch
                    android:id="@+id/swFixRung"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:text="⚡"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="TOI UU THIET BI"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Switch
                    android:id="@+id/swOptimize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:text="✨"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="BAM DAU"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Switch
                    android:id="@+id/swHead"android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:text="🛡️"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="ANTIBAN"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Switch
                    android:id="@+id/swAntiban"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:text="🎮"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="BOOST FPS"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
                <Switch
                    android:id="@+id/swBoostFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <Button
                android:id="@+id/btnPickBg"
                android:text="DOI ANH NEN"
                android:textSize="12sp"
                android:textColor="#FFFFFF"android:background="@drawable/row_bg"
                android:layout_marginEnd="4dp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btnResetBg"
                android:text="MAC DINH"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/row_bg"
                android:layout_marginStart="4dp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <Spinner
            android:id="@+id/spGame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/spinner_bg2"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnOn"
                android:text="ON"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_green"
                android:layout_marginEnd="6dp"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btnOff"
                android:text="OFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_red"
                android:layout_marginStart="6dp"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:text=""
            android:textColor="#666666"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
